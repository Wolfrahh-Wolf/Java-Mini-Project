# ─────────────────────────────────────────────────────────────────────────────
# Vehicle Service Management System — Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
#
# Usage: cp .env.example .env   (then edit .env)
# ─────────────────────────────────────────────────────────────────────────────

# Oracle JDBC thin driver connection URL
# Format: jdbc:oracle:thin:@<host>:<port>/<service_name>
DB_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1

# Oracle database username (created inside the PDB)
DB_USER=garage_user

# Oracle database password
DB_PASSWORD=GaragePass2026

# Optional: connection pool sizing (used by DBConnection util if extended)
DB_MAX_POOL_SIZE=5
