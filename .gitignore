# ─────────────────────────────────────────────────────────────────
# Vehicle Service Management System — .gitignore
# ─────────────────────────────────────────────────────────────────

# ── Credentials & Secrets ────────────────────────────────────────
.env

# ── Maven build output ───────────────────────────────────────────
target/
*.class
*.jar
*.war
*.ear

# ── Maven wrapper (optional, uncomment to track wrapper) ─────────
# !.mvn/wrapper/maven-wrapper.jar

# ── IDE — IntelliJ IDEA ──────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
out/

# ── IDE — Eclipse ─────────────────────────────────────────────────
.project
.classpath
.settings/
bin/

# ── IDE — VS Code ────────────────────────────────────────────────
.vscode/
*.code-workspace

# ── IDE — NetBeans ───────────────────────────────────────────────
nbproject/
nbbuild/
nbdist/
.nb-gradle/

# ── OS — Windows ─────────────────────────────────────────────────
Thumbs.db
Desktop.ini
ehthumbs.db

# ── OS — macOS ───────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── OS — Linux ───────────────────────────────────────────────────
*~

# ── Logs ─────────────────────────────────────────────────────────
*.log
logs/

# ── Docker runtime artefacts ─────────────────────────────────────
# (volumes are mapped to ./data — don't track DB data files)
data/

# ── Misc ─────────────────────────────────────────────────────────
*.swp
*.tmp
*.bak
